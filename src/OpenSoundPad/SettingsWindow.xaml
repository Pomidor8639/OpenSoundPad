<Window x:Class="OpenSoundPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — OSP" Height="560" Width="480"
        Background="#121418" Foreground="#E8EAF0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,6,14,14">
            <Button x:Name="OpenFolderBtn" Content="Открыть папку" Width="120" Click="OpenFolder_Click"/>
            <Button x:Name="ResetBtn" Content="Сбросить всё" Width="110" Click="Reset_Click"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,14,14,0">
            <StackPanel>
                <GroupBox x:Name="DevGroup" Header="Устройства" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="MicLabel" Text="Микрофон:" Foreground="#E8EAF0"/>
                        <ComboBox x:Name="InputBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
                        <TextBlock x:Name="CableLabel" Text="Виртуальный кабель:" Foreground="#E8EAF0"/>
                        <ComboBox x:Name="CableBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
                        <TextBlock x:Name="MonLabel" Text="Наушники:" Foreground="#E8EAF0"/>
                        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
                        <TextBlock x:Name="VirtLabel" Text="Микрофон в системе:"/>
                        <TextBlock x:Name="VirtMicText" Text="—" Foreground="#3DDC84" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button x:Name="RefreshBtn" Content="Обновить" Width="110" HorizontalAlignment="Left" Click="RefreshBtn_Click"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="ParGroup" Header="Параметры" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="PregainLabel" Text="Предусиление:" Foreground="#E8EAF0"/>
                        <Slider x:Name="PregainSlider" Minimum="100" Maximum="400" Value="220" Margin="0,2,0,8"/>
                        <TextBlock x:Name="GateLabel" Text="Шумодав:" Foreground="#E8EAF0"/>
                        <Slider x:Name="GateSlider" Minimum="0" Maximum="200" Value="30" Margin="0,2,0,4"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox x:Name="LangGroup" Header="Язык / Language" Margin="0,0,0,8">
                    <ComboBox x:Name="LangBox" Margin="0,2" SelectionChanged="LangBox_Changed"/>
                </GroupBox>
                <TextBlock x:Name="CfgLabel" Text="Файл настроек:" Foreground="#E8EAF0"/>
                <TextBlock x:Name="ConfigPathText" Text="—" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
