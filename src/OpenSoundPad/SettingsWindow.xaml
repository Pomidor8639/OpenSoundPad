<Window x:Class="OpenSoundPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — OSP" Height="340" Width="440"
        Background="#121418" Foreground="#E8EAF0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="PregainLabel" Text="Предусиление входа:" Foreground="#E8EAF0"/>
        <Slider x:Name="PregainSlider" Minimum="100" Maximum="400" Value="220" Margin="0,2,0,8"/>
        <TextBlock x:Name="GateLabel" Text="Порог шумоподавителя:" Foreground="#E8EAF0"/>
        <Slider x:Name="GateSlider" Minimum="0" Maximum="200" Value="30" Margin="0,2,0,8"/>
        <TextBlock Text="Файл настроек:" Foreground="#E8EAF0" Margin="0,6,0,0"/>
        <TextBlock x:Name="ConfigPathText" Text="—" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Открыть папку" Width="120" Click="OpenFolder_Click"/>
            <Button Content="Сбросить всё" Width="110" Click="Reset_Click"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
