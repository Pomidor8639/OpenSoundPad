<Window x:Class="OpenSoundPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — OSP" Height="640" Width="520"
        MinHeight="540" MinWidth="480"
        Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app_icon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Height="36">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource GeoWinClose}" Width="10" Height="10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Path Data="{StaticResource GeoSettings}" Width="13" Height="13" Style="{StaticResource GreenIcon}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Настройки — OpenSoundPad" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16" Background="{StaticResource BgWindow}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
            <StackPanel Margin="0,0,8,0">
                <!-- Устройства -->
                <GroupBox x:Name="DevGroup" Header="Аудиоустройства" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="MicLabel" Text="Микрофон (вход):" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,4"/>
                        <ComboBox x:Name="InputBox" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                        <TextBlock x:Name="CableLabel" Text="Виртуальный кабель (выход в Discord / игры):" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,4"/>
                        <ComboBox x:Name="CableBox" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                        <TextBlock x:Name="MonLabel" Text="Наушники (мониторинг себя):" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,4"/>
                        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                        <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,4,0,10">
                            <StackPanel>
                                <TextBlock x:Name="VirtLabel" Text="Микрофон в системе (выбрать в Discord/CS):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="VirtMicText" Text="—" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="InstallCableBtn" HorizontalAlignment="Left" Margin="0,8,0,2" Padding="10,5" Visibility="Collapsed" Click="InstallCableBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoUpload}" Width="11" Height="11" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="InstallCableBtnText" Text="Установить драйвер VB-CABLE" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button x:Name="RefreshBtn" HorizontalAlignment="Left" Padding="12,6" Click="RefreshBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoRefresh}" Width="11" Height="11" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="RefreshBtnText" Text="Обновить список устройств" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </GroupBox>

                <!-- Параметры звука -->
                <GroupBox x:Name="ParGroup" Header="Обработка звука" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,4">
                            <TextBlock x:Name="PregainLabel" Text="Предусиление входа:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </DockPanel>
                        <Slider x:Name="PregainSlider" Minimum="100" Maximum="400" Value="220" Margin="0,0,0,12"/>

                        <DockPanel Margin="0,2,0,4">
                            <TextBlock x:Name="GateLabel" Text="Шумодав (Noise Gate):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </DockPanel>
                        <Slider x:Name="GateSlider" Minimum="0" Maximum="200" Value="30" Margin="0,0,0,4"/>
                    </StackPanel>
                </GroupBox>

                <!-- Язык -->
                <GroupBox x:Name="LangGroup" Header="Язык / Language" Margin="0,0,0,10">
                    <ComboBox x:Name="LangBox" Margin="0,2" SelectionChanged="LangBox_Changed"/>
                </GroupBox>

                <!-- О приложении (About / GitHub) -->
                <GroupBox x:Name="AboutGroup" Header="О приложении" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="OSP — OpenSoundPad" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AccentGreen}"/>
                            <TextBlock x:Name="AppVersionText" Text="v1.10.0" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        </DockPanel>
                        <TextBlock x:Name="AppDescText" Text="Голосовой модулятор реального времени и саундпад с выводом в виртуальный микрофон Windows."
                                   Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="10,8">
                            <DockPanel>
                                <Path Data="{StaticResource GeoGitHub}" Width="16" Height="16" Style="{StaticResource WhiteIcon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Path Data="{StaticResource GeoExternal}" Width="11" Height="11" Style="{StaticResource GreenIcon}" Margin="6,0,0,0" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                    <Hyperlink x:Name="GitHubLink" NavigateUri="https://github.com/Pomidor8639/OpenSoundPad" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentGreen}" TextDecorations="None">
                                        https://github.com/Pomidor8639/OpenSoundPad
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Инфо о конфигурации -->
                <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="CfgLabel" Text="Файл настроек:" Foreground="{StaticResource TextSubtle}" FontSize="11"/>
                        <TextBox x:Name="ConfigPathText" Text="—" IsReadOnly="True" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель действий -->
        <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenFolderBtn" Padding="10,6" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoFolder}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="OpenFolderBtnText" Text="Папка конфига" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ResetBtn" Padding="10,6" Margin="6,3,3,3" Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoRefresh}" Width="11" Height="11" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ResetBtnText" Text="Сбросить всё" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Отмена" Width="85" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="Сохранить" Width="95" Margin="6,3,0,3" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
