<Window x:Class="OpenSoundPad.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Устройства — OSP" Height="380" Width="480"
        Background="#121418" Foreground="#E8EAF0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock Text="Микрофон:" Foreground="#E8EAF0"/>
        <ComboBox x:Name="InputBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
        <TextBlock Text="Виртуальный кабель (выход OSP):" Foreground="#E8EAF0"/>
        <ComboBox x:Name="CableBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
        <TextBlock Text="Наушники (мониторинг):" Foreground="#E8EAF0"/>
        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Name" Margin="0,3,0,8"/>
        <TextBlock Text="Микрофон в системе (выбрать в Discord):"/>
        <TextBlock x:Name="VirtMicText" Text="—" Foreground="#3DDC84" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="RefreshBtn" Content="↻ Обновить" Width="110" Click="RefreshBtn_Click"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
