<Application x:Class="OpenSoundPad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSoundPad"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Общие кисти темы Pitch Black (True Black) -->
        <SolidColorBrush x:Key="BgDarkest" Color="#000000"/>
        <SolidColorBrush x:Key="BgWindow" Color="#000000"/>
        <SolidColorBrush x:Key="BgCard" Color="#080808"/>
        <SolidColorBrush x:Key="BgCardElevated" Color="#101010"/>
        <SolidColorBrush x:Key="BgInput" Color="#141414"/>
        <SolidColorBrush x:Key="BgInputHover" Color="#202020"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669"/>
        <SolidColorBrush x:Key="AccentGreenDim" Color="#0D241A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#888888"/>
        <SolidColorBrush x:Key="TextSubtle" Color="#505050"/>

