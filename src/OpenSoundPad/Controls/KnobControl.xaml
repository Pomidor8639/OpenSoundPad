<UserControl x:Class="OpenSoundPad.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             Cursor="Hand"
             Width="110" Height="138">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Dial Canvas -->
            <RowDefinition Height="Auto"/> <!-- Value Badge -->
            <RowDefinition Height="Auto"/> <!-- Subtitle/Range -->
        </Grid.RowDefinitions>

        <!-- Заголовок крутилки -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="TITLE"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <!-- Круговой циферблат -->
        <Grid x:Name="DialCanvas" Grid.Row="1" Width="72" Height="72" HorizontalAlignment="Center" Background="Transparent">
            <!-- Фоновое кольцо шкалы (Track) -->
            <Path x:Name="TrackArc"
                  Stroke="#1C1C1C"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False"/>

            <!-- Активное цветное кольцо (Active Arc) -->
            <Path x:Name="ActiveArc"
                  Stroke="{StaticResource AccentGreen}"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False"/>

            <!-- Центральный диск крутилки (Dial Cap) -->
            <Ellipse x:Name="DialBody"
                     Width="46" Height="46"
                     Fill="#111111"
                     Stroke="#222222"
                     StrokeThickness="1.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

            <!-- Внутренний круг для объема -->
            <Ellipse Width="38" Height="38"
                     Fill="#161616"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"/>

            <!-- Вращающийся указатель -->
            <Grid Width="46" Height="46" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" CenterX="23" CenterY="23" Angle="-135"/>
                </Grid.RenderTransform>
                <Rectangle Width="3" Height="8"
                           Fill="#FFFFFF"
                           RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,3,0,0"/>
            </Grid>
        </Grid>

        <!-- Цифровое значение (Value Badge) -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkest}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,2"
                Margin="0,6,0,0"
                HorizontalAlignment="Center">
            <TextBlock x:Name="ValueText"
                       Text="0"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Подзаголовок / Диапазон -->
        <TextBlock x:Name="RangeText" Grid.Row="3"
                   Text=""
                   FontSize="9"
                   Foreground="{StaticResource TextSubtle}"
                   HorizontalAlignment="Center"
                   Margin="0,3,0,0"/>
    </Grid>
</UserControl>
