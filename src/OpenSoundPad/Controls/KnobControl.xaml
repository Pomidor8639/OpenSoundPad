<UserControl x:Class="OpenSoundPad.KnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             Cursor="Hand"
             MinWidth="86"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Dial Canvas -->
            <RowDefinition Height="Auto"/> <!-- Value Badge -->
            <RowDefinition Height="Auto"/> <!-- Subtitle/Range -->
        </Grid.RowDefinitions>

        <!-- Заголовок крутилки -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="TITLE"
                   FontSize="10" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>

        <!-- Круговой циферблат -->
        <Grid x:Name="DialCanvas" Grid.Row="1" Width="68" Height="68" HorizontalAlignment="Center" Background="Transparent">
            <!-- Фоновое кольцо шкалы (Track) -->
            <Path x:Name="TrackArc"
                  Stroke="{StaticResource BorderDark}"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False"/>

            <!-- Активное цветное кольцо (Active Arc) -->
            <Path x:Name="ActiveArc"
                  Stroke="{StaticResource AccentGreen}"
                  StrokeThickness="4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False"/>

            <!-- Центральный диск крутилки (Dial Cap) -->
            <Ellipse x:Name="DialBody"
                     Width="44" Height="44"
                     Fill="{StaticResource BgCardElevated}"
                     Stroke="{StaticResource BorderDark}"
                     StrokeThickness="1.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

            <!-- Внутренний круг для объема -->
            <Ellipse Width="36" Height="36"
                     Fill="{StaticResource BgInput}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"/>

            <!-- Вращающийся указатель -->
            <Grid Width="44" Height="44" IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" CenterX="22" CenterY="22" Angle="-135"/>
                </Grid.RenderTransform>
                <Rectangle Width="2.5" Height="8"
                           Fill="{StaticResource TextPrimary}"
                           RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,3,0,0"/>
            </Grid>
        </Grid>

        <!-- Цифровое значение (Value Badge) -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkest}"
                BorderBrush="{StaticResource BorderDark}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,3"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock x:Name="ValueText"
                       Text="0"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Подзаголовок / Диапазон -->
        <TextBlock x:Name="RangeText" Grid.Row="3"
                   Text=""
                   FontSize="9"
                   Foreground="{StaticResource TextSubtle}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"/>
    </Grid>
</UserControl>
