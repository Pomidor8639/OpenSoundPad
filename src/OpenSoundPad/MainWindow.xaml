<Window x:Class="OpenSoundPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSP — OpenSoundPad" Height="660" Width="1120"
        MinHeight="600" MinWidth="980"
        Background="#121418" Foreground="#E8EAF0"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#23262E"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <!-- стиль слайдеров задан глобально в App.xaml -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AE"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem x:Name="FileMenu" Header="Файл">
                <MenuItem x:Name="MiOpenFolder" Header="Открыть папку конфига" Click="MiOpenFolder_Click"/>
                <Separator/>
                <MenuItem x:Name="MiExit" Header="Выход" Click="MiExit_Click"/>
            </MenuItem>
            <MenuItem x:Name="SettingsMenu" Header="Настройки">
                <MenuItem x:Name="MiSettings" Header="Настройки…" Click="MiSettings_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="Справка">
                <MenuItem x:Name="MiAbout" Header="О программе" Click="MiAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Тулбар -->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button x:Name="TbStart" Content="▶ Старт" Width="92" Click="StartBtn_Click"/>
                <Button x:Name="TbStop" Content="■ Стоп" Width="85" Click="StopBtn_Click" IsEnabled="False"/>
                <Separator/>
                <Button x:Name="TbEffect" Content="Эффект выкл (T)" Width="130" Click="EffectBtn_Click"/>
                <Button x:Name="TbMute" Content="Мут (M)" Width="95" Click="MuteBtn_Click"/>
                <Button x:Name="TbMonitor" Content="Монитор (L)" Width="115" Click="MonitorBtn_Click"/>
                <Separator/>
                <Button x:Name="TbPadsStop" Content="Стоп падов" Width="95" Click="StopPadsBtn_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Центр -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Сайдбар: голоса -->
            <GroupBox Grid.Column="0" x:Name="VoicesGroup" Header="Голоса">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="EffectLabel" Text="Эффект: " VerticalAlignment="Center"/>
                        <TextBlock x:Name="EffectState" Text="АКТИВЕН" Foreground="#3DDC84" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="HotkeyHint" Text="Клавиши" TextWrapping="Wrap"
                               FontSize="11" Margin="0,8,0,0"/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock x:Name="CustomHeader" Text="Свой голос" Foreground="#E8EAF0" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PitchLabel" Text="Питч"/>
                        <Slider x:Name="PitchSlider" Minimum="-18" Maximum="18" Value="-5" ValueChanged="CustomParam_Changed"/>
                        <TextBlock x:Name="DriveLabel" Text="Дисторшн"/>
                        <Slider x:Name="DriveSlider" Minimum="0" Maximum="100" Value="25" ValueChanged="CustomParam_Changed"/>
                        <TextBlock x:Name="BassLabel" Text="Бас"/>
                        <Slider x:Name="BassSlider" Minimum="0" Maximum="15" Value="6" ValueChanged="CustomParam_Changed"/>
                        <TextBlock x:Name="RobotLabel" Text="Робот"/>
                        <Slider x:Name="RobotSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="CustomParam_Changed"/>
                        <TextBlock x:Name="VolumeLabel" Text="Громкость"/>
                        <Slider x:Name="VolumeSlider" Minimum="50" Maximum="400" Value="200" ValueChanged="Volume_Changed"/>
                    </StackPanel>
                    <ListBox x:Name="VoicesBox" SelectionChanged="VoicesBox_Changed"/>
                </DockPanel>
            </GroupBox>

            <!-- Саундпад списком -->
            <GroupBox Grid.Column="1" x:Name="PadsGroup" Header="Саундпад">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PadGainLabel" Text="Громкость падов:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="PadGainSlider" Minimum="0" Maximum="200" Value="100" Width="180" ValueChanged="PadGain_Changed"/>
                        <Button x:Name="StopPadsBtn" Content="Стоп все" Click="StopPadsBtn_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="PadsView" SelectionMode="Single"
                              MouseDoubleClick="PadsView_DoubleClick"
                              KeyDown="PadsView_KeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxLoad" Header="Загрузить звук…" Click="CtxLoad_Click"/>
                                <MenuItem x:Name="CtxClear" Header="Очистить" Click="CtxClear_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ColNum" Header="#" Width="36" DisplayMemberBinding="{Binding Num}"/>
                                <GridViewColumn x:Name="ColName" Header="Название" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn x:Name="ColDur" Header="Длит." Width="70" DisplayMemberBinding="{Binding Duration}"/>
                                <GridViewColumn x:Name="ColKey" Header="Клавиша" Width="80" DisplayMemberBinding="{Binding Key}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <!-- Уровни -->
            <GroupBox Grid.Column="2" x:Name="LevelsGroup" Header="Уровни">
                <StackPanel>
                    <TextBlock x:Name="LevelInLabel" Text="ВХОД (MIC)" Foreground="#E8EAF0"/>
                    <ProgressBar x:Name="InputVu" Minimum="0" Maximum="100" Height="14" Margin="0,2"/>
                    <TextBlock x:Name="LevelOutLabel" Text="ВЫХОД (MOD + пады)" Foreground="#E8EAF0" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="OutputVu" Minimum="0" Maximum="100" Height="14" Margin="0,2"/>
                    <Separator Margin="0,8"/>
                    <TextBlock x:Name="VirtMicHeader" Text="Микрофон в системе:"/>
                    <TextBlock x:Name="VirtMicText" Text="—" Foreground="#3DDC84" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CableHint" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Text="Если кабеля нет — установите VB-CABLE и выберите его в настройках."/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Статусбар -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Остановлен" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ConfigPathText" Text="config" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
