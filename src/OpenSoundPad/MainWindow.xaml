<Window x:Class="OpenSoundPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenSoundPad"
        Title="OSP — OpenSoundPad" Height="730" Width="1140"
        MinHeight="620" MinWidth="960"
        Background="{StaticResource BgWindow}" Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Главное меню -->
            <RowDefinition Height="Auto"/> <!-- 1: Верхняя панель управления и переключения режима -->
            <RowDefinition Height="*"/>    <!-- 2: Рабочая область выбранного режима -->
            <RowDefinition Height="Auto"/> <!-- 3: Статусбар -->
        </Grid.RowDefinitions>

        <!-- Меню программы -->
        <Menu Grid.Row="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <MenuItem x:Name="FileMenu" Header="Файл">
                <MenuItem x:Name="MiOpenFolder" Header="Открыть папку конфига" Click="MiOpenFolder_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource GeoFolder}" Width="12" Height="12" Style="{StaticResource WhiteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MiExit" Header="Выход" Click="MiExit_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource GeoClose}" Width="11" Height="11" Style="{StaticResource WhiteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="SettingsMenu" Header="Настройки">
                <MenuItem x:Name="MiSettings" Header="Настройки…" Click="MiSettings_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource GeoSettings}" Width="12" Height="12" Style="{StaticResource WhiteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="Справка">
                <MenuItem x:Name="MiAbout" Header="О программе" Click="MiAbout_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource GeoInfo}" Width="12" Height="12" Style="{StaticResource WhiteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Верхняя панель управления (Toolbar) -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="12,7">
            <DockPanel LastChildFill="False">
                <!-- Слева: ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМОВ (Войсмод / Саундпад) + Статус + Старт/Стоп -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Переключатель режима: Войсмод vs Саундпад -->
                    <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeVoiceRadio" Style="{StaticResource ModeRadioStyle}"
                                         IsChecked="True" Click="ModeVoice_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoMic}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ModeVoiceText" Text="Войсмод" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModePadRadio" Style="{StaticResource ModeRadioStyle}"
                                         Click="ModePad_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoSoundpad}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ModePadText" Text="Саундпад" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Бейдж статуса аудиоядра -->
                    <Border x:Name="StatusBadge" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                            CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusBadgeText" Text="ОСТАНОВЛЕН" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Старт / Стоп мастер-вещания -->
                    <Button x:Name="TbStart" Width="96" Padding="10,6"
                            FontWeight="SemiBold" Background="{StaticResource AccentGreen}" Foreground="#FFFFFF" BorderBrush="{StaticResource AccentGreenHover}"
                            Click="StartBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPlay}" Width="10" Height="10" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TbStartText" Text="Старт" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="TbStop" Width="90" Padding="10,6"
                            IsEnabled="False" Click="StopBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoStop}" Width="9" Height="9" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TbStopText" Text="Стоп" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{StaticResource BorderDark}" Margin="12,3"/>

                    <!-- Быстрые действия для режима «Войсмод» -->
                    <StackPanel x:Name="VoiceToolbarActions" Orientation="Horizontal">
                        <Button x:Name="TbEffect" MinWidth="130" Click="EffectBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoWand}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbEffectText" Text="Эффект выкл (T)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TbMute" MinWidth="95" Click="MuteBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoMute}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbMuteText" Text="Мут (M)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TbMonitor" MinWidth="115" Click="MonitorBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHeadphones}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbMonitorText" Text="Монитор (L)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Быстрые действия для режима «Саундпад» -->
                    <StackPanel x:Name="SoundpadToolbarActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="TbPadsStop" Padding="12,6" Click="StopPadsBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoStop}" Width="10" Height="10" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbPadsStopText" Text="Стоп всех падов" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TbPadMonitor" MinWidth="140" Click="MonitorBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHeadphones}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TbPadMonitorText" Text="Монитор падов (L)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Справа: Настройки -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="TbSettings" Padding="12,6" Click="MiSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSettings}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TbSettingsText" Text="Настройки…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- РЕЖИМ 1: ВОЙСМОД (2 ЧИСТЫЕ КОЛОНКИ: ПРЕСЕТЫ СЛЕВА / СТУДИЯ + МИКШЕР СПРАВА) -->
        <!-- ========================================================================= -->
        <Grid x:Name="VoiceModeGrid" Grid.Row="2" Margin="10" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Пресеты голоса + Статус устройств -->
            <GroupBox Grid.Column="0" x:Name="VoicesGroup" Header="Голосовые пресеты (1–5)" Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <!-- Нижний блок: Устройства и подсказка клавиш -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <!-- Аудиоустройства -->
                        <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="ActiveDevHeader" Text="Текущие устройства:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                                    <Button x:Name="OpenSettingsBtn" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="MiSettings_Click">
                                        <TextBlock x:Name="OpenSettingsBtnText" Text="Изменить" Foreground="{StaticResource AccentGreen}" FontSize="10"/>
                                    </Button>
                                </DockPanel>
                                <TextBlock x:Name="DevMicTitle" Text="Микрофон:" Foreground="{StaticResource TextSubtle}" FontSize="10"/>
                                <TextBlock x:Name="InputDevText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DevCableTitle" Text="Виртуальный кабель:" Foreground="{StaticResource TextSubtle}" FontSize="10"/>
                                <TextBlock x:Name="CableDevText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DevMonTitle" Text="Монитор:" Foreground="{StaticResource TextSubtle}" FontSize="10"/>
                                <TextBlock x:Name="MonitorDevText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="VirtMicHeader" Text="Микрофон в Discord/играх:" Foreground="{StaticResource TextSubtle}" FontSize="10"/>
                                <TextBlock x:Name="VirtMicText" Text="—" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CableHint" Visibility="Collapsed" Text=""/>
                            </StackPanel>
                        </Border>

                        <!-- Подсказка клавиш -->
                        <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="8,5">
                            <TextBlock x:Name="VoiceHotkeyHint" Text="1-5 пресеты • T эффект • M мут • L монитор"
                                       FontSize="10" Foreground="{StaticResource TextSubtle}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Список пресетов и карточка выбранного -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Статус активности эффекта -->
                        <Border Grid.Row="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock x:Name="EffectLabel" Text="Эффект обработки:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EffectState" Text="АКТИВЕН" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Список пресетов (1–5) -->
                        <ListBox Grid.Row="1" x:Name="VoicesBox" SelectionChanged="VoicesBox_Changed" Margin="0,0,0,6"/>

                        <!-- Описание выбранного голоса -->
                        <Border Grid.Row="2" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="VoiceDescHeader" Text="Описание эффекта:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock x:Name="VoiceDescText" Text="Маскировка тембра" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <!-- Правая колонка: Настройка параметров + Микшер уровней -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Секция 1: Студия кастомного тембра (4 ползунка) -->
                <GroupBox Grid.Row="0" x:Name="VoiceStudioGroup" Header="Студия кастомного голоса (пресет 5)" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <!-- Верхний бар студии со сбросом -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <DockPanel>
                                <Button x:Name="ResetVoiceBtn" DockPanel.Dock="Right" Padding="10,4" FontSize="11" Click="ResetCustomVoice_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Width="10" Height="10" Style="{StaticResource WhiteIcon}" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="ResetVoiceText" Text="Сбросить" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CustomHeader" Text="Тонкая настройка тембра" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="CustomHintText" Text="При изменении параметров активным становится пресет 5 (Свой)" Foreground="{StaticResource TextSubtle}" FontSize="10"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4 аналоговые крутилки тембра в сетке 2x2 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Питч (Row 0, Col 0) -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="0,0,5,5">
                                <local:KnobControl x:Name="PitchKnob"
                                                   Title="ПИТЧ"
                                                   Subtitle="(-18 .. +18 st)"
                                                   Minimum="-18" Maximum="18"
                                                   Value="-5" DefaultValue="-5"
                                                   Step="0.5"
                                                   IsBipolar="True"
                                                   Unit="st"
                                                   Format="+0.0;-0.0;0.0"
                                                   ValueChanged="KnobParam_Changed"/>
                            </Border>

                            <!-- Дисторшн (Row 0, Col 1) -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="5,0,0,5">
                                <local:KnobControl x:Name="DriveKnob"
                                                   Title="ДИСТОРШН"
                                                   Subtitle="(0 .. 100%)"
                                                   Minimum="0" Maximum="100"
                                                   Value="25" DefaultValue="25"
                                                   Step="1"
                                                   Unit="%"
                                                   Format="0"
                                                   ValueChanged="KnobParam_Changed"/>
                            </Border>

                            <!-- Бас (Row 1, Col 0) -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="0,5,5,0">
                                <local:KnobControl x:Name="BassKnob"
                                                   Title="БАС"
                                                   Subtitle="(0 .. +15 дБ)"
                                                   Minimum="0" Maximum="15"
                                                   Value="6" DefaultValue="6"
                                                   Step="0.5"
                                                   Unit="дБ"
                                                   Format="+0.0"
                                                   ValueChanged="KnobParam_Changed"/>
                            </Border>

                            <!-- Робот (Row 1, Col 1) -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,8" Margin="5,5,0,0">
                                <local:KnobControl x:Name="RobotKnob"
                                                   Title="РОБОТИЗАЦИЯ"
                                                   Subtitle="(0 .. 100%)"
                                                   Minimum="0" Maximum="100"
                                                   Value="0" DefaultValue="0"
                                                   Step="1"
                                                   Unit="%"
                                                   Format="0"
                                                   ValueChanged="KnobParam_Changed"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </GroupBox>

                <!-- Секция 2: Микшер микрофона и индикаторы уровня VU -->
                <GroupBox Grid.Row="1" x:Name="LevelsGroup" Header="Микшер и уровни громкости" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Крутилка громкости микрофона -->
                        <Border Grid.Column="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,6" Margin="0,0,8,0">
                            <local:KnobControl x:Name="VolumeKnob"
                                               Title="ГРОМКОСТЬ"
                                               Subtitle="(50 .. 400%)"
                                               Minimum="50" Maximum="400"
                                               Value="200" DefaultValue="200"
                                               Step="5"
                                               Unit="%"
                                               Format="0"
                                               Width="110"
                                               ValueChanged="VolumeKnob_Changed"/>
                        </Border>

                        <!-- Индикаторы входа и выхода -->
                        <Border Grid.Column="1" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Вход -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock x:Name="LevelInLabel" Text="ВХОД МИКРОФОНА" Foreground="{StaticResource TextSubtle}" FontSize="10" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar Grid.Row="1" x:Name="InputVu" Minimum="0" Maximum="100" Height="12" Margin="0,0,0,10"/>

                                <!-- Выход -->
                                <DockPanel Grid.Row="2" Margin="0,0,0,4">
                                    <TextBlock x:Name="LevelOutLabel" Text="ВЫХОД В ЭФИР (ОБРАБОТКА + ПАДЫ)" Foreground="{StaticResource TextSubtle}" FontSize="10" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar Grid.Row="3" x:Name="OutputVu" Minimum="0" Maximum="100" Height="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- РЕЖИМ 2: САУНДПАД (ТАБЛИЦА НА ВЕСЬ ЭКРАН + ЕДИНЫЙ НИЖНИЙ ПУЛЬТ)           -->
        <!-- ========================================================================= -->
        <Grid x:Name="SoundpadModeGrid" Grid.Row="2" Margin="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Список 12 слотов -->
                <RowDefinition Height="Auto"/> <!-- Единая нижняя консоль управления -->
            </Grid.RowDefinitions>

            <!-- Основная таблица слотов падов -->
            <GroupBox Grid.Row="0" x:Name="PadsGroup" Header="Саундпад" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <!-- Нижняя строка подсказки -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                            CornerRadius="5" Padding="10,6" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock x:Name="PadHotkeyHint" DockPanel.Dock="Right" Text="F1-F12 запуск • Пробел играть • Del удалить • Esc стоп всех"
                                       Foreground="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoInfo}" Width="12" Height="12" Style="{StaticResource MutedIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PadDropHint" Text="Перетащите файлы (.mp3, .wav, .ogg, .flac) из Проводника прямо в таблицу или нажмите «+ Добавить звук»"
                                           Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Список падов с поддержкой плейсхолдера пустого состояния -->
                    <Grid>
                        <ListView x:Name="PadsView" SelectionMode="Single"
                                  AllowDrop="True"
                                  Drop="PadsView_Drop"
                                  DragOver="PadsView_DragOver"
                                  MouseDoubleClick="PadsView_DoubleClick"
                                  KeyDown="PadsView_KeyDown">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="CtxPlay" Header="Играть" Click="CtxPlay_Click">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoPlay}" Width="10" Height="10" Style="{StaticResource WhiteIcon}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="CtxStop" Header="Стоп" Click="CtxStop_Click">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoStop}" Width="9" Height="9" Style="{StaticResource WhiteIcon}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="CtxAdd" Header="Добавить звук…" Click="AddPadBtn_Click">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoPlus}" Width="11" Height="11" Style="{StaticResource WhiteIcon}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="CtxClear" Header="Удалить из списка" Click="CtxClear_Click">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoTrash}" Width="11" Height="11" Style="{StaticResource WhiteIcon}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn x:Name="ColStatus" Header=" " Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Path Data="{StaticResource GeoPlay}" Width="10" Height="10" Style="{StaticResource GreenIcon}"
                                                      Visibility="{Binding PlayingVisibility}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn x:Name="ColNum" Header="№" Width="40" DisplayMemberBinding="{Binding Num}"/>
                                    <GridViewColumn x:Name="ColKey" Header="Клавиша" Width="75" DisplayMemberBinding="{Binding Key}"/>
                                    <GridViewColumn x:Name="ColName" Header="Название сэмпла" Width="660" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn x:Name="ColDur" Header="Длит." Width="80" DisplayMemberBinding="{Binding Duration}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Пустое состояние (когда список пуст) -->
                        <Border x:Name="EmptyPadsPlaceholder" Background="Transparent" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSoundpad}" Width="36" Height="36" Style="{StaticResource MutedIcon}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="EmptyPadsText" Text="Звуки пока не добавлены" Foreground="{StaticResource TextMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Нажмите «+ Добавить звук» ниже или перетащите аудиофайлы сюда" Foreground="{StaticResource TextSubtle}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </GroupBox>

            <!-- ЕДИНАЯ НИЖНЯЯ ПАНЕЛЬ САУНДПАДА -->
            <GroupBox Grid.Row="1" x:Name="PadControlGroup" Header="Управление воспроизведением" Margin="0">
                <DockPanel LastChildFill="False">
                    <!-- Слева: Добавить, Удалить, Очистить все -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button x:Name="AddPadBtn" Padding="12,6" FontWeight="SemiBold" Click="AddPadBtn_Click"
                                Background="{StaticResource AccentGreenDim}" BorderBrush="{StaticResource AccentGreen}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPlus}" Width="11" Height="11" Style="{StaticResource GreenIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="AddPadBtnText" Text="Добавить звук…" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemovePadBtn" Padding="10,6" Margin="4,0,0,0" Click="CtxClear_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoTrash}" Width="11" Height="11" Style="{StaticResource WhiteIcon}" Margin="0,0,5,0"/>
                                <TextBlock x:Name="RemovePadBtnText" Text="Удалить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearAllPadsBtn" Padding="10,6" Margin="4,0,0,0" Click="ClearAllPads_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoAlert}" Width="11" Height="11" Style="{StaticResource WhiteIcon}" Margin="0,0,5,0"/>
                                <TextBlock x:Name="ClearAllPadsText" Text="Очистить всё" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Справа: Стоп всех + Монитор наушников + Индикатор выхода -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Индикатор звука выхода саундпада -->
                        <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ВЫХОД:" Foreground="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ProgressBar x:Name="PadOutputVu" Minimum="0" Maximum="100" Width="90" Height="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Слушать в наушниках -->
                        <Button x:Name="PadMonitorBtn" Padding="10,6" Margin="0,0,8,0" Click="MonitorBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoHeadphones}" Width="12" Height="12" Style="{StaticResource WhiteIcon}" Margin="0,0,5,0"/>
                                <TextBlock x:Name="PadMonitorBtnText" Text="Монитор (L)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Стоп всех сэмплов (выделенная кнопка) -->
                        <Button x:Name="StopPadsBtn" Padding="12,6" FontWeight="SemiBold" Click="StopPadsBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoStop}" Width="10" Height="10" Style="{StaticResource WhiteIcon}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StopPadsBtnText" Text="Стоп всех (Esc)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- По центру: Громкость сэмплов + статус количества играющих -->
                    <Border Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="5" Padding="12,4" Margin="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PadGainLabel" Text="Громкость: 100%" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="PadGainSlider" Minimum="0" Maximum="200" Value="100" Width="140" VerticalAlignment="Center" ValueChanged="PadGain_Changed"/>
                            <Border Width="1" Background="{StaticResource BorderDark}" Margin="10,2"/>
                            <TextBlock x:Name="ActivePadsCountText" Text="Играет: 0" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Невидимые совместимые привязки для вывода кабеля в саундпаде (MainWindow.xaml.cs совместимость) -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="CableDevText2"/>
                <TextBlock x:Name="VirtMicText2"/>
            </StackPanel>
        </Grid>

        <!-- Статусбар (True Black) -->
        <StatusBar Grid.Row="3" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Остановлен" FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </StatusBarItem>
            <Separator Margin="8,2"/>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSubtle}" FontSize="10" Padding="4,1" Margin="0" Cursor="Hand"
                        Click="MiOpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoFolder}" Width="11" Height="11" Style="{StaticResource MutedIcon}" Margin="0,0,5,0"/>
                        <TextBlock Text="Папка конфигурации" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
