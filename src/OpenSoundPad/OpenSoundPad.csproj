<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenSoundPad</AssemblyName>
    <RootNamespace>OpenSoundPad</RootNamespace>
    <ApplicationIcon>..\..\app_icon.ico</ApplicationIcon>
    <AssemblyTitle>OSP OpenSoundPad</AssemblyTitle>
    <Product>OSP OpenSoundPad</Product>
    <Company>OSP OpenSoundPad Community</Company>
    <Version>1.11.0</Version>
    <Description>OSP OpenSoundPad - Real-Time Voice Changer + SoundPad</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\app_icon.ico" Link="app_icon.ico" />
  </ItemGroup>

</Project>
