<Window x:Class="OpenSoundPad.WelcomeLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSoundPad — Select Language"
        Width="620" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        Icon="pack://application:,,,/app_icon.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BgWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <Border Grid.Row="0" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Height="36">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnClose_Click" ToolTip="Close">
                        <Path Data="{StaticResource GeoWinClose}" Width="10" Height="10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/app_icon.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OSP — OpenSoundPad" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="24,18,24,10" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="Welcome to OpenSoundPad" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubPromptText" Text="Please choose your preferred language / 选择语言 / 言語を選択 / 언어 선택" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Language Cards Grid: 2 columns x 4 rows -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- English -->
                <Border x:Name="CardEn" Grid.Row="0" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,6,8" Cursor="Hand" MouseLeftButtonDown="CardEn_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/gb.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckEn" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Visible"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="English" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Default language" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Русский -->
                <Border x:Name="CardRu" Grid.Row="1" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,6,8" Cursor="Hand" MouseLeftButtonDown="CardRu_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/ru.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckRu" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Русский" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Russian" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Deutsch -->
                <Border x:Name="CardDe" Grid.Row="2" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,6,8" Cursor="Hand" MouseLeftButtonDown="CardDe_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/de.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckDe" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Deutsch" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="German" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Español -->
                <Border x:Name="CardEs" Grid.Row="3" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CardEs_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/es.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckEs" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Español" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Spanish" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Français -->
                <Border x:Name="CardFr" Grid.Row="0" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,8" Cursor="Hand" MouseLeftButtonDown="CardFr_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/fr.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckFr" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Français" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="French" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 简体中文 -->
                <Border x:Name="CardZh" Grid.Row="1" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,8" Cursor="Hand" MouseLeftButtonDown="CardZh_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/cn.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckZh" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="简体中文" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Chinese" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 日本語 -->
                <Border x:Name="CardJa" Grid.Row="2" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,8" Cursor="Hand" MouseLeftButtonDown="CardJa_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/jp.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckJa" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="日本語" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Japanese" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 한국어 -->
                <Border x:Name="CardKo" Grid.Row="3" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="CardKo_Click">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" CornerRadius="3" ClipToBounds="True" Width="26" Height="18" Margin="0,0,12,0" VerticalAlignment="Center" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <Image Source="pack://application:,,,/Flags/kr.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Path x:Name="CheckKo" Data="{StaticResource GeoCheck}" Width="14" Height="14" Style="{StaticResource GreenIcon}" DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="한국어" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Korean" FontSize="10" Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="{StaticResource BgDarkest}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="You can change language anytime in Settings" Foreground="{StaticResource TextSubtle}" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="ContinueBtn" Content="Continue" DockPanel.Dock="Right" Width="120" Height="32" Padding="12,6"
                        Background="{StaticResource AccentGreen}" Foreground="Black" FontWeight="Bold" FontSize="12"
                        Click="ContinueBtn_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
